{
  "name": "a4tech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npx prisma generate",
    "dev": "next dev",
    "build": "next build && node -e \"const fs=require('fs'); if(fs.existsSync('.next/standalone')){ fs.cpSync('public', '.next/standalone/public', {recursive: true, force: true}); fs.cpSync('.next/static', '.next/standalone/.next/static', {recursive: true, force: true}); }\"",
    "start": "node server.js",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "build:analyze": "ANALYZE=true next build",
    "clean": "rm -rf .next out node_modules/.cache"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/extension-color": "^3.2.0",
    "@tiptap/extension-image": "^3.2.0",
    "@tiptap/extension-link": "^3.2.0",
    "@tiptap/extension-text-style": "^3.2.0",
    "@tiptap/extension-underline": "^3.2.0",
    "@tiptap/react": "^3.2.0",
    "@tiptap/starter-kit": "^3.2.0",
    "@tsparticles/engine": "^4.3.2",
    "@tsparticles/react": "^4.3.2",
    "@tsparticles/slim": "^4.3.2",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.5.19",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.539.0",
    "mysql": "^2.18.1",
    "next": "15.4.10",
    "nodemailer": "^9.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-google-recaptcha": "^3.1.0",
    "sanitize-html": "^2.17.0",
    "swr": "^2.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "prisma": "^6.14.0",
    "tailwindcss": "^4"
  }
}
